# BigBrain Configuration
# Copy to .env and fill in your API key(s)

# === Web research (Brave Search API, separate from LLM keys) ===
BRAVE_API_KEY=
# Bounded research envelope; includes reported cached input and conservative
# reservations when usage is unknown. Codex calls include native context overhead.
# BIGBRAIN_RESEARCH_TOKENS=120000
# Source-aligned extraction: pip install -e ".[research]"
# Rendered reads additionally need .[web] and: python -m playwright install chromium
# BIGBRAIN_RESEARCH_BROWSER=0  # Disable rendered reads; HTTP observations remain available.

# === ChatGPT subscription (Codex CLI must be installed) ===
# If codex is not on the server's PATH, set its absolute executable path.
# BIGBRAIN_CODEX_BINARY=/absolute/path/to/codex

# === LLM Provider (set at least one) ===
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=AIza...

# === Model Selection ===
# BIGBRAIN_MODEL=gpt-4o-mini          # Default model for all brains
# BIGBRAIN_FRONT_MODEL=gpt-4o         # Front Brain (conversation) — can be different
# BIGBRAIN_CODE_MODEL=gpt-4o-mini     # Code generation model

# === System ===
# BIGBRAIN_WORKSPACE=demo
# BIGBRAIN_LOG_DIR=logs
# BIGBRAIN_MAX_TOKENS=2048
# BIGBRAIN_CODE_TIMEOUT=30
# BIGBRAIN_TEMPERATURE=0.7
