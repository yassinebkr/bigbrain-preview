+// An integrated editor reserves a distinct recovery slot for its accepted base.
+const SCOPED_RECOVERY_PREFIX: &str = "bigbrain-recovery-";
+
+fn recovery_scope() -> Option<String> {
+    let query = web_sys::window()?.location().search().ok()?;
+    url::form_urlencoded::parse(query.trim_start_matches('?').as_bytes())
+        .find(|(key, _)| key == "bigbrain-recovery")
+        .map(|(_, value)| value.into_owned())
+        .filter(|value| value.len() == 64 && value.bytes().all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b)))
+}
+
+fn recovery_storage_name(scope: Option<&str>, name: &str) -> String {
+    match scope {
+        Some(scope) => format!("{SCOPED_RECOVERY_PREFIX}{scope}-{name}"),
+        None => name.to_owned(),
+    }
+}
+
+fn recovery_input_name(name: &str, scope: Option<&str>) -> Option<String> {
+    if let Some(scope) = scope {
+        let prefix = format!("{SCOPED_RECOVERY_PREFIX}{scope}-");
+        if let Some(recovery) = name.strip_prefix(&prefix) {
+            return [RECOVERY, RECOVERY_META].contains(&recovery).then(|| recovery.to_owned());
+        }
+        if [RECOVERY, RECOVERY_META].contains(&name) || LEGACY_RECOVERY.contains(&name) {
+            return None;
+        }
+    }
+    (!name.starts_with(SCOPED_RECOVERY_PREFIX)).then(|| name.to_owned())
+}
+
